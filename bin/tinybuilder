#!/bin/bash
# TinyBuilder — construye sitios y SaaS con modelos locales pequeños.
#
# usage:
#   tinybuilder [project-dir] [flags de little-coder...]
#   tinybuilder --setup      configura todo desde cero
#   tinybuilder --doctor     diagnostica el entorno
#   tinybuilder --templates  lista los templates disponibles

set -e

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Templates: primero los del repo (vienen incluidos), luego los globales.
if [ -d "$ROOT/templates" ] && [ -n "$(ls -A "$ROOT/templates" 2>/dev/null)" ]; then
  TEMPLATES_DIR="$ROOT/templates"
else
  TEMPLATES_DIR="${TINYBUILDER_TEMPLATES:-$HOME/.config/little-coder/templates}"
fi
PROJECT="$PWD"
ARGS=()
MODE="run"

for arg in "$@"; do
  case "$arg" in
    --setup) MODE="setup" ;;
    --doctor) MODE="doctor" ;;
    --templates) MODE="templates" ;;
    --help|-h) MODE="help" ;;
    *)
      if [ "$MODE" = "run" ] && [ $# -gt 0 ] && [ "${arg#-}" = "$arg" ] && [ -z "$PROJECT_SET" ]; then
        PROJECT="$arg"
        PROJECT_SET=1
      else
        ARGS+=("$arg")
      fi
      ;;
  esac
done

# ── colores ──────────────────────────────────────────────────────────
if [ -t 1 ]; then
  BOLD="\033[1m"; DIM="\033[2m"; CYAN="\033[36m"; GREEN="\033[32m"
  YELLOW="\033[33m"; RED="\033[31m"; RESET="\033[0m"
else
  BOLD=""; DIM=""; CYAN=""; GREEN=""; YELLOW=""; RED=""; RESET=""
fi

say()  { printf "%b\n" "$*"; }
ok()   { printf "${GREEN}  ✓${RESET} %b\n" "$*"; }
warn() { printf "${YELLOW}  !${RESET} %b\n" "$*"; }
bad()  { printf "${RED}  ✗${RESET} %b\n" "$*"; }

# ── doctor ───────────────────────────────────────────────────────────
check_ollama() {
  if command -v ollama >/dev/null 2>&1; then
    if curl -s --max-time 3 http://127.0.0.1:11434/api/version >/dev/null 2>&1; then
      ok "Ollama running"
      return 0
    fi
    warn "Ollama installed but not responding on :11434 (open the app)"
    return 1
  fi
  bad "Ollama not installed"
  say "     ${DIM}brew install --cask ollama${RESET}"
  return 1
}

check_models() {
  local list
  list="$(ollama list 2>/dev/null || true)"

  if printf '%s' "$list" | grep -q "bonsai-2-4b-16k"; then
    ok "Bonsai 2 4B 16k (main model)"
  elif printf '%s' "$list" | grep -q "bonsai-2-4b"; then
    warn "Bonsai present without the 16k variant"
    say "     ${DIM}Create it with: tinybuilder --setup${RESET}"
  else
    bad "Missing Bonsai 2 4B"
    say "     ${DIM}ollama pull hf.co/prismml/bonsai-2:4b-q2_0${RESET}"
  fi

  if printf '%s' "$list" | grep -q "Qwen3.5-0.8B"; then
    ok "Qwen3.5 0.8B (writes the code)"
  else
    bad "Missing Qwen3.5 0.8B"
    say "     ${DIM}ollama pull hf.co/unsloth/Qwen3.5-0.8B-GGUF:Q4_K_M${RESET}"
  fi
}

check_node() {
  if command -v node >/dev/null 2>&1; then
    local v
    v="$(node -v)"
    local major
    major="$(printf '%s' "$v" | sed 's/^v//' | cut -d. -f1)"
    if [ "$major" -ge 22 ]; then
      ok "Node $v"
    else
      bad "Node $v is too old (need >= 22.19)"
    fi
  else
    bad "Node not installed"
    say "     ${DIM}brew install node${RESET}"
  fi
}

check_ram() {
  local bytes gb
  bytes="$(sysctl -n hw.memsize 2>/dev/null || echo 0)"
  gb=$((bytes / 1073741824))
  if [ "$gb" -ge 8 ]; then
    ok "RAM: ${gb} GB"
  else
    warn "RAM: ${gb} GB — too little for this setup"
  fi
}

check_little_coder() {
  if [ -x "$ROOT/node_modules/.bin/little-coder" ]; then
    ok "little-coder (bundled in this project)"
  else
    bad "little-coder missing from the project"
    say "     ${DIM}cd \"$ROOT\" && npm install${RESET}"
  fi
}

doctor() {
  say ""
  say "${BOLD}${CYAN}TinyBuilder — doctor${RESET}"
  say ""
  check_node
  check_ollama || true
  check_models
  check_ram
  check_little_coder
  say ""
  say "${DIM}Templates:${RESET}"
  local tdir="$TEMPLATES_DIR"
  if [ -d "$tdir" ]; then
    for t in "$tdir"/*; do
      [ -d "$t" ] && ok "$(basename "$t")"
    done
  else
    warn "No templates installed"
  fi
  say ""
}

templates() {
  say ""
  say "${BOLD}${CYAN}Templates${RESET}"
  say ""
  local dir="$TEMPLATES_DIR"
  if [ ! -d "$dir" ]; then
    warn "No templates in $dir"
    say ""
    return
  fi
  for t in "$dir"/*; do
    [ -d "$t" ] || continue
    local name
    name="$(basename "$t")"
    case "$name" in
      static-astrowind) say "  ${CYAN}static-astrowind${RESET}   ${DIM}Astro 7 + Tailwind 4 (sites, blogs)${RESET}" ;;
      saas-nextjs-starter) say "  ${CYAN}saas-nextjs-starter${RESET} ${DIM}Next 14 + auth + drizzle + Whop${RESET}" ;;
      *) say "  ${CYAN}$name${RESET}" ;;
    esac
  done
  say ""
  say "${DIM}Copy one with:${RESET}"
  say "  cp -R $dir/static-astrowind/. ."
  say ""
}

help() {
  say ""
  say "${BOLD}TinyBuilder${RESET} ${DIM}— sites and SaaS with small local models${RESET}"
  say ""
  say "  ${CYAN}tinybuilder${RESET}                open the current directory"
  say "  ${CYAN}tinybuilder${RESET} ~/project       open that project"
  say "  ${CYAN}tinybuilder${RESET} --setup         set up the environment"
  say "  ${CYAN}tinybuilder${RESET} --doctor        diagnose what is missing"
  say "  ${CYAN}tinybuilder${RESET} --templates     list available templates"
  say ""
  say "${DIM}Inside TinyBuilder:${RESET}"
  say "  /panel        hide or show the side panel"
  say "  /serve        local server and preview URL"
  say "  /stop         stop the server"
  say "  /check        review project consistency"
  say "  alt+e         edit the open file"
  say "  ctrl+shift+c  review the project now"
  say ""
}

setup() {
  say ""
  say "${BOLD}${CYAN}TinyBuilder — setup${RESET}"
  say ""

  if ! command -v ollama >/dev/null 2>&1; then
    warn "Installing Ollama..."
    brew install --cask ollama || bad "Could not install Ollama"
  else
    ok "Ollama already installed"
  fi

  say "${DIM}Pulling Bonsai 2 4B (~1.6 GB)...${RESET}"
  ollama pull hf.co/prismml/bonsai-2:4b-q2_0 || warn "Could not pull Bonsai"

  say "${DIM}Pulling Qwen3.5 0.8B (~737 MB)...${RESET}"
  ollama pull hf.co/unsloth/Qwen3.5-0.8B-GGUF:Q4_K_M || warn "Could not pull Qwen"

  say ""
  say "${DIM}Bonsai ships with 262k context, which on 8 GB of RAM uses 12 GB and swaps to disk."
  say "We create a 16k variant that runs entirely on the GPU:${RESET}"

  local mf
  mf="$(mktemp)"
  cat > "$mf" <<'MODELFILE'
FROM bonsai-2:4b-q2_0
PARAMETER num_ctx 16384
PARAMETER temperature 0.6
PARAMETER top_p 0.9
PARAMETER top_k 20
PARAMETER presence_penalty 1
MODELFILE
  ollama create bonsai-2-4b-16k -f "$mf" && ok "bonsai-2-4b-16k created"
  rm -f "$mf"

  if [ ! -x "$ROOT/node_modules/.bin/little-coder" ]; then
    warn "Installing project dependencies..."
    (cd "$ROOT" && npm install) || bad "Could not install dependencies"
  else
    ok "Project dependencies already installed"
  fi

  say ""
  say "${GREEN}Done.${RESET} Run ${CYAN}tinybuilder --doctor${RESET} to verify."
  say ""
}

# ── dispatch ─────────────────────────────────────────────────────────
case "$MODE" in
  doctor) doctor; exit 0 ;;
  templates) templates; exit 0 ;;
  help) help; exit 0 ;;
  setup) setup; exit 0 ;;
esac

# ── run ──────────────────────────────────────────────────────────────

# little-coder viaja con el proyecto. Si falta, avisamos antes de fallar.
LC_BIN="$ROOT/node_modules/.bin/little-coder"
if [ ! -x "$LC_BIN" ]; then
  bad "Falta little-coder dentro del proyecto."
  say "     ${DIM}cd \"$ROOT\" && npm install${RESET}"
  say "     ${DIM}o ejecuta: tinybuilder --setup${RESET}"
  exit 1
fi

[ -z "$OLLAMA_API_KEY" ] && export OLLAMA_API_KEY=noop

# Las extensiones, skills, templates y modelos viven en este repo.
export TINYBUILDER_HOME="$ROOT"
export LITTLE_CODER_EXTENSIONS_DIR="$ROOT/extensions"
export LITTLE_CODER_MODELS_FILE="$ROOT/models.json"

if [ ! -d "$PROJECT" ]; then
  bad "Directory does not exist: $PROJECT"
  exit 1
fi

cd "$PROJECT" || exit 1

exec "$LC_BIN" --model ollama/bonsai-2-4b-16k "${ARGS[@]}"
